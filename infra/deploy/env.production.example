# Production / staging environment file for infra/docker-compose.prod.yml (ADR 0041).
#
# Copy to /opt/jobfinder/.env on the server, fill in EVERY value marked REQUIRED, chmod 600. Never commit the filled
# file. Generate secrets with: openssl rand -hex 24   (48 characters, letters and digits only)
# infra/deploy/preflight.sh checks this file and refuses a deploy with placeholders, short secrets or unsafe settings.
# The full list of what to obtain and where is in docs/launch-checklist.md.

# ---- Public name and TLS (REQUIRED) -----------------------------------------------------------------------------------
# The DNS A/AAAA record of this name must point at the server; ports 80 and 443 must be open to the internet. Caddy gets
# and renews the certificate by itself.
SITE_ADDRESS=change-me-app-host-name
WEB_BASE_URL=https://change-me-app-host-name
# Contact address for the certificate authority (expiry notices). Optional.
ACME_EMAIL=

# ---- Images (REQUIRED) ------------------------------------------------------------------------------------------------
# Where CI publishes them: ghcr.io/<owner>/jobfinder (see .github/workflows/deploy.yml). The tag is given to deploy.sh.
IMAGE_REGISTRY=change-me-registry-path

# ---- Secrets (REQUIRED) -----------------------------------------------------------------------------------------------
POSTGRES_USER=jobfinder
POSTGRES_DB=jobfinder
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_USER=jobfinder
RABBITMQ_PASSWORD=change-me-rabbitmq
# Letters and digits only (it is part of a URL).
REDIS_PASSWORD=change-me-redis
JWT_SECRET=change-me-jwt-secret
AI_SERVICE_TOKEN=change-me-ai-service-token
NOTIFICATIONS_UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret

# ---- Object storage (REQUIRED): Cloudflare R2 or any S3-compatible store ---------------------------------------------
# Private bucket for CVs and rendered files. R2 endpoint: https://<account-id>.r2.cloudflarestorage.com, region auto.
OBJECT_STORAGE_ENDPOINT=change-me-object-storage-endpoint
OBJECT_STORAGE_BUCKET=jobfinder
OBJECT_STORAGE_ACCESS_KEY=change-me-access-key
OBJECT_STORAGE_SECRET_KEY=change-me-secret-key
OBJECT_STORAGE_REGION=auto
# Only when browsers must reach the store under a different host than core-api does. Usually empty.
OBJECT_STORAGE_PUBLIC_ENDPOINT=

# ---- Email (REQUIRED) -------------------------------------------------------------------------------------------------
MAIL_HOST=change-me-smtp-host
MAIL_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATIONS_MAIL_FROM=no-reply@change-me-your-domain

# ---- AI providers -----------------------------------------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSION=1024
VOYAGE_API_KEY=
AI_DAILY_CAP_CREDITS=500

# ---- Payments (blank: that provider is not offered) -------------------------------------------------------------------
# With a key set, ALL of that provider's price and plan values must be real (core-api refuses to start otherwise).
# Webhook URLs to register with the providers: https://<SITE_ADDRESS>/api/core/webhooks/stripe and .../paystack
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_USD=
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_PRO_NGN=
BILLING_PRICE_PRO_USD_MINOR=
BILLING_PRICE_PRO_NGN_MINOR=
BILLING_PRICE_PACK_SMALL_USD_MINOR=
BILLING_PRICE_PACK_SMALL_NGN_MINOR=
BILLING_PRICE_PACK_LARGE_USD_MINOR=
BILLING_PRICE_PACK_LARGE_NGN_MINOR=

# ---- Sign-in, first admin, alerts -------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
# First admin: set both, start once, then REMOVE ADMIN_PASSWORD from this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
INGESTION_ALERT_RECIPIENTS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_RAPIDAPI_KEY=

# ---- Uploads ----------------------------------------------------------------------------------------------------------
# ClamAV runs by default (needs about 2 GB of memory). Setting none requires ALLOW_NO_UPLOAD_SCAN=true as well.
# UPLOAD_SCANNER_TYPE=none
# ALLOW_NO_UPLOAD_SCAN=true

# ---- Backups (docs/runbooks/backup-restore.md) -----------------------------------------------------------------------
# How long backups are kept. The privacy policy states 30 days (RETENTION_DAYS.backups in the web app); change both together.
BACKUP_RETENTION_DAYS=30
BACKUP_TIME_UTC=01:40
# Off-host copy (strongly recommended: the sidecar's volume lives on this host's disk). Use a bucket and credentials that
# are NOT the application's, ideally write-only plus delete of old backups.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
# path | virtual | auto. Empty = the client default. Oracle Cloud Object Storage: path (docs/runbooks/oci-always-free.md).
BACKUP_S3_ADDRESSING_STYLE=
# Encryption of backup files (required with BACKUP_S3_URI). Create the file on the host: openssl rand -hex 32 > FILE;
# chown 999:999 FILE; chmod 400 FILE. Keep a copy in the password manager: without it the backups cannot be restored.
BACKUP_PASSPHRASE_HOST_FILE=
BACKUP_PASSPHRASE_FILE=

# ---- Observability ----------------------------------------------------------------------------------------------------
CORE_API_SENTRY_DSN=
AI_SERVICE_SENTRY_DSN=
WEB_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
