# Resource limits for a SMALL host: the OCI Ampere A1 staging VM of docs/runbooks/oci-always-free.md (1 OCPU, 8 GB of memory).
# Append these lines to the staging .env (they override only the defaults of infra/docker-compose.prod.yml). Values are
# limits, not reservations; the total (about 5.75 GiB) leaves about 2 GiB of an 8 GB host for the operating system, the
# page cache and the swap-backed headroom. On a 6 GB host this does not fit with ClamAV: use 8 GB.
# Nothing here is a secret.
CADDY_MEM_LIMIT=128m
CADDY_CPUS=0.25
POSTGRES_MEM_LIMIT=768m
POSTGRES_CPUS=1
REDIS_MEM_LIMIT=256m
REDIS_CPUS=0.25
RABBITMQ_MEM_LIMIT=512m
RABBITMQ_CPUS=0.5
# ClamAV needs about 1.5 GB once the signature database is loaded; below that it is killed by the memory limit.
CLAMAV_MEM_LIMIT=1792m
CLAMAV_CPUS=1
CORE_API_MEM_LIMIT=1280m
CORE_API_CPUS=1
AI_SERVICE_MEM_LIMIT=640m
AI_SERVICE_CPUS=0.5
WEB_MEM_LIMIT=384m
WEB_CPUS=0.5
BACKUP_MEM_LIMIT=128m
BACKUP_CPUS=0.25
