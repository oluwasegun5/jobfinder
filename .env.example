# Copy to .env and adjust as needed. Local development only — never commit the real .env.

# Postgres
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=jobfinder
POSTGRES_DB=jobfinder
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=jobfinder
RABBITMQ_PASSWORD=jobfinder
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Object storage (S3-compatible, via Adobe S3Mock — see docs/adr/0009-local-object-storage.md)
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_BUCKET=jobfinder

# Mailpit (local SMTP catcher)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# core-api
CORE_API_PORT=8080

# ai-service
AI_SERVICE_PORT=8000
# Shared secret core-api sends as X-Service-Token (min 32 chars). Generate your own: openssl rand -hex 32
AI_SERVICE_TOKEN=local-dev-only-ai-service-token-change-me
# LLM routes return 503 until ANTHROPIC_API_KEY is set; health and queues work without it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-5
