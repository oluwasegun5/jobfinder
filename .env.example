# Placeholders only. Run `make env` to create .env with freshly generated random secrets (it replaces every
# change-me-* value), or copy this file and set your own. Nothing here is a usable default: the stack and core-api
# refuse to start without real values. Never commit the real .env.

# Postgres
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=jobfinder
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=jobfinder
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Object storage (S3-compatible, via Adobe S3Mock — see docs/adr/0009-local-object-storage.md)
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_BUCKET=jobfinder
# S3Mock accepts any key pair. In production these are the Cloudflare R2 API token credentials.
OBJECT_STORAGE_ACCESS_KEY=change-me-access-key
OBJECT_STORAGE_SECRET_KEY=change-me-secret-key

# Mailpit (local SMTP catcher)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# core-api
CORE_API_PORT=8080
# HS256 key for access tokens (min 32 chars; core-api refuses to start without it). Generate your own: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
# Base URL used in the links inside verification / password-reset emails
WEB_BASE_URL=http://localhost:3000
# Set to false only if you serve the web app over plain http on a non-localhost host
AUTH_COOKIE_SECURE=true
# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services > Credentials).
# Add http://localhost:3000 as an authorised JavaScript origin. Blank disables Google sign-in (also hides the button in web; rebuild the web image after changing it).
GOOGLE_CLIENT_ID=
# Optional first admin. Promotes the account if it exists; creates a verified one if ADMIN_PASSWORD is set (min 10 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Source alerts (docs/adr/0024-source-dashboard-alerts.md): comma-separated admin emails told when a job source returns
# no jobs or most of its targets fail. Blank (the default) only logs the alert. Locally they land in Mailpit.
INGESTION_ALERT_RECIPIENTS=

# Digests, instant alerts and unsubscribe links (docs/adr/0028-notifications.md). Both jobs run in core-api; set false to
# stop them. The digest job runs hourly (at minute 5) and sends the digests whose hour has come; the cron is in UTC.
NOTIFICATIONS_DIGEST_ENABLED=true
NOTIFICATIONS_DIGEST_CRON=0 5 * * * *
NOTIFICATIONS_INSTANT_ENABLED=true
# Signs the unsubscribe links in emails (min 32 chars). Blank derives a key from JWT_SECRET; set your own in production.
NOTIFICATIONS_UNSUBSCRIBE_SECRET=
NOTIFICATIONS_MAIL_FROM=no-reply@jobfinder.local

# Job aggregators (docs/adr/0021-aggregator-adapters.md). Remotive, Arbeitnow and Remote OK need no key.
# A blank key leaves that source registered but skipped (the reason is logged at startup).
# Adzuna: free app id and key from https://developer.adzuna.com/ (check its terms before commercial use).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch: your RapidAPI key for https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free plan: 200 requests a month).
JSEARCH_RAPIDAPI_KEY=

# ai-service
AI_SERVICE_PORT=8000
# Shared secret core-api sends as X-Service-Token (min 32 chars). Generate your own: openssl rand -hex 32
AI_SERVICE_TOKEN=change-me-ai-service-token
# LLM routes return 503 until ANTHROPIC_API_KEY is set; health and queues work without it.
# LLM_PROVIDER=fake is a keyless stand-in for local runs of match scoring and resume tailoring ONLY (a keyword heuristic
# and a reorder-only tailoring, not a model; usage records say provider=fake, cost 0; CV parsing stays unavailable).
# Never the default.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a workspace (the API then answers "must include the anthropic-workspace-id header").
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-5
# Label of the pinned price list (LLM_PRICING in ai-service app/config.py). Bump it when a price changes: every usage
# record carries it (docs/adr/0025-ai-usage-ledger.md).
LLM_PRICING_VERSION=2026-10-01

# AI usage cap (core-api, docs/adr/0025-ai-usage-ledger.md): the most credits one user's AI calls may use per UTC day
# (0 = no cap), and how many millionths of a dollar one credit stands for. Defaults: $0.50 a day per user.
AI_DAILY_CAP_CREDITS=500
AI_MICRO_USD_PER_CREDIT=1000

# Matching engine (core-api, docs/adr/0026-matching-engine.md). The nightly run that fills every active user's match
# scores (a ShedLock lock keeps it to one instance), and its cron in UTC. Weights, recall size and the rest are
# app.matching.* in application.yml (override with APP_MATCHING_* environment variables).
MATCHING_BATCH_ENABLED=true
MATCHING_BATCH_CRON=0 30 2 * * *

# Embeddings (docs/adr/0022-embeddings-pipeline.md). core-api and ai-service must agree on the model and the
# dimension; core-api refuses vectors from any other. The dimension is also fixed in the database column
# (vector(1024)), so changing it needs a migration, and changing the model re-embeds everything.
# Keyless local default: deterministic fake vectors (they carry no meaning, so matching quality needs a real provider).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embed-1024
EMBEDDING_DIMENSION=1024
# Real embeddings: https://dashboard.voyageai.com/ then set EMBEDDING_PROVIDER=voyage, EMBEDDING_MODEL=voyage-4 and
# the key below. Without a key the embedding queues are simply not consumed.
VOYAGE_API_KEY=

# web
WEB_PORT=3000
