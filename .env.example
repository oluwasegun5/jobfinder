# Copy to .env and adjust as needed. Local development only — never commit the real .env.

# Postgres
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=jobfinder
POSTGRES_DB=jobfinder
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=jobfinder
RABBITMQ_PASSWORD=jobfinder
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Object storage (S3-compatible, via Adobe S3Mock — see docs/adr/0009-local-object-storage.md)
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_BUCKET=jobfinder
# S3Mock accepts any key pair. In production these are the Cloudflare R2 API token credentials.
OBJECT_STORAGE_ACCESS_KEY=local
OBJECT_STORAGE_SECRET_KEY=local

# Mailpit (local SMTP catcher)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# core-api
CORE_API_PORT=8080
# HS256 key for access tokens (min 32 chars; core-api refuses to start without it). Generate your own: openssl rand -hex 32
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
# Base URL used in the links inside verification / password-reset emails
WEB_BASE_URL=http://localhost:3000
# Set to false only if you serve the web app over plain http on a non-localhost host
AUTH_COOKIE_SECURE=true
# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services > Credentials).
# Add http://localhost:3000 as an authorised JavaScript origin. Blank disables Google sign-in (also hides the button in web; rebuild the web image after changing it).
GOOGLE_CLIENT_ID=
# Optional first admin. Promotes the account if it exists; creates a verified one if ADMIN_PASSWORD is set (min 10 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Source alerts (docs/adr/0024-source-dashboard-alerts.md): comma-separated admin emails told when a job source returns
# no jobs or most of its targets fail. Blank (the default) only logs the alert. Locally they land in Mailpit.
INGESTION_ALERT_RECIPIENTS=

# Job aggregators (docs/adr/0021-aggregator-adapters.md). Remotive, Arbeitnow and Remote OK need no key.
# A blank key leaves that source registered but skipped (the reason is logged at startup).
# Adzuna: free app id and key from https://developer.adzuna.com/ (check its terms before commercial use).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch: your RapidAPI key for https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free plan: 200 requests a month).
JSEARCH_RAPIDAPI_KEY=

# ai-service
AI_SERVICE_PORT=8000
# Shared secret core-api sends as X-Service-Token (min 32 chars). Generate your own: openssl rand -hex 32
AI_SERVICE_TOKEN=local-dev-only-ai-service-token-change-me
# LLM routes return 503 until ANTHROPIC_API_KEY is set; health and queues work without it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_STRONG=claude-sonnet-5

# Embeddings (docs/adr/0022-embeddings-pipeline.md). core-api and ai-service must agree on the model and the
# dimension; core-api refuses vectors from any other. The dimension is also fixed in the database column
# (vector(1024)), so changing it needs a migration, and changing the model re-embeds everything.
# Keyless local default: deterministic fake vectors (they carry no meaning, so matching quality needs a real provider).
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embed-1024
EMBEDDING_DIMENSION=1024
# Real embeddings: https://dashboard.voyageai.com/ then set EMBEDDING_PROVIDER=voyage, EMBEDDING_MODEL=voyage-4 and
# the key below. Without a key the embedding queues are simply not consumed.
VOYAGE_API_KEY=

# web
WEB_PORT=3000
